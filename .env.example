# Terrablox configuration.
#
#   cp .env.example .env
#
# One file, at the repo root, read by everything:
#
#   pnpm dev              the dashboard's dev script passes --env-file-if-exists
#   pnpm start            same
#   pnpm db:*             the Prisma CLI runs from the root and finds it itself
#   pnpm db:builtin:*     loaded with node --env-file-if-exists
#   docker compose up     compose reads the root .env on its own
#
# `pnpm dev` needs that flag because Next only looks for .env files next to the app
# it is building — `apps/dashboard/.env`, not the repo root. Without it the dev
# server starts with no DATABASE_URL and no GitHub credentials, and the login page
# fails in a way that looks like a broken GitHub App. Do not solve that by creating
# apps/dashboard/.env: it is a legacy path (see scripts/quickstart.sh) and it would
# put DATABASE_URL in two files that have to be kept in sync.
#
# Anything already present in the environment wins: this file never overwrites an
# exported shell variable or a variable set on a container, so `docker run -e ...`
# and `BETTER_AUTH_URL=... pnpm dev` still override it.
#
# Nothing here has a secret as a default. An instance that boots with a
# predictable BETTER_AUTH_SECRET is an instance where anyone can forge a session.
#
# Leave a variable commented out rather than setting it empty. The code falls back
# with `||`, so an empty value is treated as unset, but a commented-out line is
# the honest way to say "not configured".


# --- required ---------------------------------------------------------------

# Signs sessions, and is HKDF-derived into the AES-256-GCM key that encrypts
# stored AWS credentials and MCP auth headers
# (apps/dashboard/src/lib/crypto/secret-box.ts). Generate it once and keep it:
# rotating it logs everyone out *and* makes every stored secret undecryptable.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# `pnpm quickstart` generates one for you if this is empty.
BETTER_AUTH_SECRET=

# GitHub sign-in. The only way in, and the same grant is what lets the agent read
# and write repositories — without these two values the app starts and the login
# page can do nothing.
#
# Register a **GitHub App**, not an OAuth App:
#   personal:      https://github.com/settings/apps/new
#   organisation:  https://github.com/organizations/<YOUR-ORG>/settings/apps/new
#
# An OAuth App will get you as far as signing in and no further. The repository
# listing asks GitHub which repositories the *installation* was granted, and those
# endpoints reject an OAuth token — so every picker in the app comes back empty.
#
# Settings that matter:
#   Callback URL:  <BETTER_AUTH_URL>/api/auth/callback/github
#   "Request user authorization (OAuth) during installation": enabled
#   Webhook: inactive (nothing consumes them)
#
# Permissions, and each one is load-bearing:
#   Repository → Metadata: Read
#   Repository → Contents: Read and write        read and commit Terraform
#   Repository → Workflows: Read and write       commits under .github/workflows/
#   Repository → Actions: Read and write         start and watch deploy runs
#   Repository → Variables: Read and write       the pipeline's configuration
#   Repository → Administration: Read and write  create a project's repository
#   Account    → Email addresses: Read           a primary email at sign-in
#
# See docs/quickstart.md for the walkthrough.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# A GitHub App has TWO return URLs and they are not interchangeable:
#
#   Callback URL   http://localhost:3001/api/auth/callback/github
#                  The OAuth redirect. Better Auth owns it and validates the
#                  `state` it issued when it started the sign-in.
#
#   Setup URL      http://localhost:3001/api/github/installations/callback
#                  Where GitHub returns after an install, a permission change, or
#                  a request sent to an organisation owner. GitHub starts this one,
#                  so there is no `state` to validate.
#
# Two settings decide which of them an installation returns to, and getting it wrong
# has one visible symptom:
#
#   /api/auth/error?error=state_not_found
#
# That happens when "Request user authorization (OAuth) during installation" is left
# ENABLED. GitHub then sends the post-install redirect to the Callback URL, Better
# Auth looks for a state it never issued, and the person who just granted access is
# shown an error. Turn that option OFF and set the Setup URL instead. Nothing is lost:
# whoever installs the app is already signed in.
#
# Also tick "Redirect on update", so a changed selection returns the same way.
# Both URLs use the origin in BETTER_AUTH_URL.

# Which GitHub App this instance is, taken from its public page:
# https://github.com/apps/<slug>. Used only to link users to the install and
# "change repository access" pages, so it is cosmetic until somebody has to grant
# access — at which point a wrong value sends them to a 404.
#
# Defaults to `terrablox`, the app published at github.com/apps/terrablox. Set it
# to your own slug when you register your own app, which is the expected case for a
# self-hosted instance.
# GITHUB_APP_SLUG=terrablox


# --- where this instance lives ----------------------------------------------

# The address users reach this instance on, scheme included. Behind a reverse
# proxy or a load balancer this is the public address, not the container's. Wrong
# here means GitHub sends people back to a host that is not serving the app.
BETTER_AUTH_URL=http://localhost:3001

# The same URL for the browser bundle, and optional on purpose: left unset the
# client falls back to window.location.origin, which is what keeps one Docker
# image valid for every hostname you put it behind.
#
# Set it only if you need the client pinned to an absolute URL — and note it is
# inlined at build time, so for Docker it is a build argument
# (`--build-arg NEXT_PUBLIC_APP_URL=...`), not a runtime variable.
# NEXT_PUBLIC_APP_URL=http://localhost:3001


# --- database: local development --------------------------------------------

# Used by `pnpm dev` and every `pnpm db:*` command. The default matches the
# throwaway Postgres that `pnpm db:up` starts (docker-compose.local.yml).
#
# `docker compose up` ignores this. That stack builds its own connection string
# from the POSTGRES_* values below, because inside compose the database is
# reached by service name rather than on localhost.
DATABASE_URL=postgresql://terrablox:terrablox@localhost:5433/terrablox


# --- database: docker compose (self-hosting) --------------------------------

# Only `docker compose up` reads this block; `pnpm dev` ignores it entirely.

# Required for docker compose. The port is not published and only the dashboard
# container ever uses this, so length matters more than memorability.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Changing these after the volume exists renames nothing — the data directory is
# initialised on first start only.
POSTGRES_USER=terrablox
POSTGRES_DB=terrablox

# Host port the dashboard is published on.
TERRABLOX_PORT=3001

# Image tag, and the tag compose builds into.
TERRABLOX_VERSION=latest


# --- features ---------------------------------------------------------------

# Whether the shipped terrablox-aws-* catalogue is visible. Visibility only: the
# rows arrive via `pnpm db:builtin:sync`, which is a repo script and not part of
# the container's startup. Turning it off leaves the rows in place, so turning it
# back on is instant — but while it is off, a project whose Terraform already
# calls one of these modules renders that call as a node with no inputs or
# outputs. Check with `pnpm db:builtin:status`.
TERRABLOX_BUILTIN_MODULES=true

# Token `pnpm db:builtin:sync` uses to read the public terrablox-aws-*
# repositories. No scopes are needed. GITHUB_TOKEN and GH_TOKEN work too, so with
# the gh CLI logged in you can leave this unset and pass one per invocation:
#   GITHUB_TOKEN=$(gh auth token) pnpm db:builtin:sync
# TERRABLOX_SEED_GITHUB_TOKEN=


# --- rarely needed ----------------------------------------------------------

# `next dev` and `next build` both own .next, and running them at the same time
# makes each rewrite the other's manifests. Point a build at its own directory to
# check it without stopping the dev server: NEXT_DIST_DIR=.next-build pnpm build
# NEXT_DIST_DIR=

# Let the dashboard container apply migrations on startup instead of running the
# one-off `migrate` service. Off by default: two containers starting at once
# would both run `prisma migrate deploy` against the same database.
# RUN_MIGRATIONS=false
