# Database Configuration
# Adapter options: supabase | postgres | mysql | mongodb | custom
DATABASE_ADAPTER=supabase

# Supabase Configuration (if using Supabase)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Database Connection (if using custom database)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication Configuration
# Adapter options: supabase | auth0 | nextauth | custom
AUTH_ADAPTER=supabase

# NextAuth Configuration (if using NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret

# App URLs
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002

