# Terrablox configuration: cp .env.example .env (or run `pnpm quickstart`).
# Walkthrough and details: docs/quickstart.md

# --- required ---------------------------------------------------------------

# Signs sessions and encrypts stored secrets. Generate once; rotating it logs
# everyone out and makes stored secrets unreadable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of this instance.
BETTER_AUTH_URL=http://localhost:3001

# GitHub App (not an OAuth App), see docs/quickstart.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local Postgres from `pnpm db:up`. Ignored by `docker compose up`.
DATABASE_URL=postgresql://terrablox:terrablox@localhost:5433/terrablox

# --- docker compose (self-hosting) ------------------------------------------

# Required for `docker compose up`:  openssl rand -base64 24
POSTGRES_PASSWORD=
# POSTGRES_USER=terrablox
# POSTGRES_DB=terrablox
# TERRABLOX_PORT=3001
# TERRABLOX_VERSION=latest
# Apply migrations on dashboard start instead of the one-off `migrate` service.
# RUN_MIGRATIONS=false

# --- optional ---------------------------------------------------------------

# Module libraries as one JSON array; unset = this default. Fields and usage:
# docs/quickstart.md#module-libraries
# TERRABLOX_MODULE_LIBRARIES=[{"id":"terrablox","name":"Terrablox","scope":"global","visible":true,"org":"terrablox","prefix":"terrablox-aws-","submoduleContainer":"modules"},{"id":"porsche","name":"Porsche","scope":"user","visible":true,"org":"porsche-code","topics":["aws","cbbac"]}]

# Slug from github.com/apps/<slug>, for install links.
# GITHUB_APP_SLUG=terrablox
