{
  "name": "terrablox",
  "private": true,
  "description": "Open source, fully local Terraform assistant and infrastructure designer",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "turbo run build",
    "build:mcp": "pnpm --filter @terrablox/mcp-server build",
    "check": "biome check --write .",
    "check:ci": "biome ci .",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:builtin:relink": "node --env-file-if-exists=.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/relink.mts",
    "db:builtin:reset": "node --env-file-if-exists=.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/reset.mts",
    "db:builtin:status": "node --env-file-if-exists=.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/status.mts",
    "db:builtin:sync": "node --env-file-if-exists=.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/main.mts",
    "catalogue:snapshot": "node --import ./scripts/seed-builtin-modules/register.mjs ./scripts/snapshot-catalogue.mts && biome check --write packages/catalogue/src/entries.generated.ts",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "db:generate": "pnpm --filter @terrablox/database exec prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "db:up": "docker compose -f docker-compose.local.yml up -d",
    "dev": "turbo run dev",
    "dev:dashboard": "turbo run dev --filter=@terrablox/dashboard",
    "dev:website": "turbo run dev --filter=@terrablox/website",
    "docker:build": "docker build -t terrablox/dashboard:latest .",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f dashboard",
    "docker:up": "docker compose up -d --build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "turbo run lint",
    "quickstart": "bash ./scripts/quickstart.sh",
    "start": "turbo run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "turbo run type-check"
  },
  "dependencies": {
    "@terrablox/database": "workspace:*",
    "@terrablox/git": "workspace:^",
    "@terrablox/terraform": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@turbo/gen": "^2.11.7",
    "prisma": "5.22.0",
    "turbo": "^2.11.7",
    "vitest": "^5.0.3",
    "yaml": "^2.9.0"
  },
  "prisma": {
    "schema": "packages/database/prisma/schema.prisma"
  }
}
