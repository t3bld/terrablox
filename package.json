{
  "name": "terrablox",
  "private": true,
  "description": "Open source, fully local Terraform assistant and infrastructure designer",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "quickstart": "bash ./scripts/quickstart.sh",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --apply .",
    "check:ci": "biome ci .",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "type-check": "turbo run type-check",
    "db:up": "docker compose -f docker-compose.local.yml up -d",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "docker:build": "docker build -t terrablox/dashboard:latest .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f dashboard",
    "db:push": "pnpm --filter @terrablox/database db:push",
    "db:migrate": "pnpm --filter @terrablox/database db:migrate:deploy",
    "db:reset": "pnpm --filter @terrablox/database db:migrate:reset",
    "db:generate": "pnpm --filter @terrablox/database db:generate",
    "db:studio": "pnpm --filter @terrablox/database db:studio",
    "db:builtin:sync": "node --env-file-if-exists=apps/dashboard/.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/main.mts",
    "db:builtin:status": "node --env-file-if-exists=apps/dashboard/.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/status.mts",
    "db:builtin:relink": "node --env-file-if-exists=apps/dashboard/.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/relink.mts",
    "db:builtin:reset": "node --env-file-if-exists=apps/dashboard/.env --import ./scripts/seed-builtin-modules/register.mjs ./scripts/seed-builtin-modules/reset.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@turbo/gen": "^2.7.3",
    "turbo": "^2.7.3"
  }
}
