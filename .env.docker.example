# Configuration for docker-compose.yml. Copy to .env in the repo root.
#
#   cp .env.docker.example .env
#
# This is separate from apps/dashboard/.env, which configures `pnpm dev` and
# points at a database on localhost:5433. Inside compose the database is reached
# by service name, so the two files cannot be shared.

# --- required ---------------------------------------------------------------

# Postgres password. Only the dashboard container ever uses it, and the port is
# not published, so length matters more than memorability.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs sessions and derives the key that encrypts stored AWS and Infracost
# credentials. Rotating it logs everyone out and makes existing stored secrets
# undecryptable, so generate it once and keep it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# GitHub sign-in. The only way in, and the same grant is what lets the agent read
# and write repositories. The callback URL registered on the GitHub app must be
# <BETTER_AUTH_URL>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- optional ---------------------------------------------------------------

# The URL users type to reach this instance, scheme included. Behind a reverse
# proxy or load balancer this is the public address, not the container's.
BETTER_AUTH_URL=http://localhost:3001

# Host port to publish the dashboard on.
TERRABLOX_PORT=3001

# Image tag, and the tag compose builds into.
TERRABLOX_VERSION=latest

# Postgres user and database name. Changing these after the volume exists will
# not rename anything - the data directory is initialised on first start only.
POSTGRES_USER=terrablox
POSTGRES_DB=terrablox

# Whether the shipped terrablox-aws-* catalogue is visible. Note that this flag
# only controls visibility: the rows arrive via `pnpm db:builtin:sync`, which is
# a repo script and not part of the container's startup.
TERRABLOX_BUILTIN_MODULES=true
