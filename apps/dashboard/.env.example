# =============================================================================
# Client-side environment variables (exposed to browser)
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3001

# =============================================================================
# Server-side environment variables (NOT exposed to browser)
# =============================================================================

# Local Postgres - start it with `docker compose up -d` at the repo root.
DATABASE_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"
DIRECT_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"

# Better Auth - the quick start generates this for you.
# To create one manually:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit a real value here: a shared secret would let anyone forge sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# GitHub sign-in (optional - only needed to import Terraform modules from GitHub).
# Recommended for organisations: register a GitHub App at
#   https://github.com/organizations/<YOUR-ORG>/settings/apps/new
# with Callback URL http://localhost:3001/api/auth/callback/github,
# "Request user authorization (OAuth) during installation" enabled, and the
# repository permissions Contents: Read-only + Metadata: Read-only.
# A classic OAuth App (https://github.com/settings/developers) also works, but
# then each user must grant the broad `repo` scope themselves.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Project agent - runs on each signed-in user's own GitHub Copilot subscription,
# so TerraBlox needs no model API key and pays for no tokens. Users without a
# Copilot seat simply get a message saying so.
#
# Nothing to install or start: the Copilot CLI comes in via pnpm install and is
# spawned as a child process. Optional override, defaults to "auto", which picks
# whatever model the user is entitled to.
# COPILOT_MODEL=

# AWS accounts (optional) - the identity customers' roles trust. TerraBlox holds
# no AWS keys: it assumes a role in the customer's account for the length of one
# request. It discovers its own principal automatically via sts:GetCallerIdentity,
# so all it needs is AWS credentials (a task role, or the usual AWS_* env vars).
#
# Set this only to override that - e.g. to name the account root, or when the
# trusted principal differs from the caller. To see what would be discovered:
#   aws sts get-caller-identity --query Arn --output text
# TERRABLOX_AWS_PRINCIPAL_ARN=
