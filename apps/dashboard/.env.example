# =============================================================================
# Client-side environment variables (exposed to browser)
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3001

# =============================================================================
# Server-side environment variables (NOT exposed to browser)
# =============================================================================

# Local Postgres - start it with `docker compose -f docker-compose.local.yml up -d` (or `pnpm db:up`).
DATABASE_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"
DIRECT_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"

# Better Auth - the quick start generates this for you.
# To create one manually:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never commit a real value here: a shared secret would let anyone forge sessions.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The module catalogue TerraBlox ships with (the terrablox-aws-* repositories).
# Defaults to true. Set to false for a bare instance where users only see modules
# they imported themselves.
#
# This one flag decides both whether `pnpm db:builtin:sync` will write the
# catalogue and whether anyone can see it. Turning it off leaves the rows in
# place, so turning it back on is instant - but while it is off, a project whose
# Terraform already calls one of these modules renders that call as a node with
# no inputs or outputs. Check with `pnpm db:builtin:status`.
TERRABLOX_BUILTIN_MODULES=true

# GitHub sign-in - REQUIRED. It is the only way to sign in, and the same grant is
# what lets the agent read and write your repositories. Without these two values
# the app starts and the login page can do nothing.
#
# `pnpm quickstart` asks for them interactively.
#
# Recommended for organisations: register a GitHub App at
#   https://github.com/organizations/<YOUR-ORG>/settings/apps/new
# with Callback URL http://localhost:3001/api/auth/callback/github,
# "Request user authorization (OAuth) during installation" enabled, and the
# repository permissions Contents: Read-only + Metadata: Read-only.
# A classic OAuth App (https://github.com/settings/developers) also works, but
# then each user must grant the broad `repo` scope themselves.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional. Every one of these has a working default; they are listed because the
# code reads them, and an undocumented variable is one nobody can find.
# -----------------------------------------------------------------------------

# GitHub App mode. With all three set, repositories are read through the App
# installation rather than through each user's own OAuth token, so every member
# sees the same modules. A classic OAuth App needs none of them.
# The private key is the whole PEM, newlines included - quote it.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# What the project agent runs on when a user has made no choice. Both fall back
# to the values in src/lib/agent/copilot.ts.
COPILOT_MODEL=
COPILOT_REASONING_EFFORT=

# AWS. Left empty, deployment uses the region and identity of whatever
# credentials it finds, which is the right answer on a developer machine and in
# a pipeline alike. Set them only to override that.
AWS_REGION=
TERRABLOX_AWS_PRINCIPAL_ARN=
