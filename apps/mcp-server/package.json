{
  "name": "@terrablox/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Serves the curated Terraform module library to any MCP host, with an interactive review UI. Reads no database and reaches no network.",
  "type": "module",
  "bin": {
    "terrablox-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "build": "node ./build.mjs && biome check --write src/ui.generated.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "start": "node ./dist/bin.js",
    "probe": "node ./probe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.3.0",
    "@terrablox/catalogue": "workspace:*",
    "@terrablox/terraform": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@modelcontextprotocol/client": "2.3.0",
    "@terrablox/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
