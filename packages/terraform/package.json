    "./evaluate": "./src/evaluate.ts",
    "./hcl-edit": "./src/hcl-edit.ts",
    "./identifier-suggest": "./src/identifier-suggest.ts",
    "./module-interface": "./src/module-interface.ts",
    "./module-link": "./src/module-link.ts",
    "./output-type": "./src/output-type.ts",
    "./references": "./src/references.ts",
    "./registry": "./src/registry.ts",
