generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

model Profile {
  id        String   @id @db.Uuid
  email     String?  @db.Text
  fullName  String?  @map("full_name") @db.Text
  avatarUrl String?  @map("avatar_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
  @@schema("public")
}

model Project {
  id          String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  canvasNodes CanvasNode[]
  connections Connection[]

  @@map("projects")
  @@schema("public")
}

model TerraformModuleSource {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.Text
  description String?  @db.Text
  tags        String[] @default([]) @db.Text
  url         String   @db.Text
  provider    String   @default("github") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions TerraformModule[]

  @@map("terraform_module_sources")
  @@schema("public")
}

model TerraformModule {
  id                  String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  versionTag          String?  @map("version_tag") @db.Text
  description         String?  @db.Text
  url                 String?  @db.Text
  sourceId            String?  @map("source_id") @db.Uuid
  terraformRootFolder String?  @map("terraform_root_folder") @db.Text
  terraformSubmodulesFolders String[] @map("terraform_submodules_folders") @default([]) @db.Text
  variables           Json     @default("[]") @db.JsonB
  outputs             Json     @default("[]") @db.JsonB
  isSubmodule         Boolean  @default(false) @map("is_submodule")
  parentModuleId      String?  @map("parent_module_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source       TerraformModuleSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  parentModule TerraformModule?      @relation("ModuleHierarchy", fields: [parentModuleId], references: [id], onDelete: SetNull)
  submodules   TerraformModule[]     @relation("ModuleHierarchy")
  resources    ProviderResource[]
  canvasNodes  CanvasNode[]

  @@unique([sourceId, versionTag, terraformRootFolder])
  @@map("terraform_modules")
  @@schema("public")
}

model CanvasNode {
  id            String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  name          String   @db.Text
  positionX     Float    @default(0) @map("position_x") @db.DoublePrecision
  positionY     Float    @default(0) @map("position_y") @db.DoublePrecision
  width         Float?   @default(200) @db.DoublePrecision
  height        Float?   @default(150) @db.DoublePrecision
  configuration Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project           Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module            TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sourceConnections Connection[] @relation("SourceNode")
  targetConnections Connection[] @relation("TargetNode")

  @@map("canvas_nodes")
  @@schema("public")
}

model Connection {
  id           String   @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  sourceNodeId String   @map("source_node_id") @db.Uuid
  sourceOutput String   @map("source_output") @db.Text
  targetNodeId String   @map("target_node_id") @db.Uuid
  targetInput  String   @map("target_input") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode CanvasNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode CanvasNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@map("connections")
  @@schema("public")
}

model ProviderResource {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId            String  @map("module_id") @db.Uuid
  resourceType        String  @map("resource_type") @db.Text
  resourceName        String? @map("resource_name") @db.Text
  providerName        String  @map("provider_name") @db.Text
  version             String? @db.Text
  resourceUrl         String? @map("resource_url") @db.Text
  providerUrl         String? @map("provider_url") @db.Text
  resourceDescription String? @map("resource_description") @db.Text

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("provider_resources")
  @@schema("public")
}

