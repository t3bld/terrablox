generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "multiSchema"]
}

// One connection string, not two. `directUrl` used to be declared here for
// pooler setups, but Prisma treats every env() in this block as required: it made
// DIRECT_URL a variable everyone had to set to the exact same value as
// DATABASE_URL, and the Docker entrypoint had to copy one into the other to stop
// the CLI from refusing to start.
//
// If you do put a pooler (pgBouncer, Accelerate) in front of Postgres, add
// `directUrl = env("DIRECT_URL")` back and point it at the direct connection —
// `prisma migrate` needs one.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

// =============================================================================
// Better Auth - authentication tables (local, no external provider)
// =============================================================================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String   @db.Text
  email         String   @unique @db.Text
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  /// When this person asked an organisation owner to approve the GitHub App.
  ///
  /// Recorded because GitHub will not tell us. A member without admin rights on an
  /// organisation cannot install the app, so GitHub files a request for an owner to
  /// approve and returns `setup_action=request` — and a *pending* request is not an
  /// installation, so it appears in no API this app can reach. Listing installation
  /// requests needs app-level authentication with the app's private key, which a
  /// self-hosted instance deliberately does not hold.
  ///
  /// Without this the pending state was indistinguishable from "never asked": every
  /// repository picker said "Terrablox is not installed on GitHub yet", the person
  /// requested it again, and the loop only ended when an owner happened to approve.
  ///
  /// Cleared as soon as an installation is actually observed, which is what makes this
  /// self-healing rather than a flag that needs its own housekeeping — approval,
  /// rejection and a request that was abandoned all end the same way: an installation
  /// appears, or the person asks again and this is overwritten.
  githubInstallRequestedAt DateTime? @map("github_install_requested_at") @db.Timestamptz(6)

  sessions        Session[]
  accounts        Account[]
  awsConnections  AwsConnection[]
  awsSsoLogins    AwsSsoLogin[]
  agentSettings   AgentSettings?
  agentMcpServers AgentMcpServer[]
  apiTokens       ApiToken[]
  harnessCuration HarnessCuration?
  auditEvents     AuditEvent[]
  moduleLibrarySyncs ModuleLibrarySync[]

  @@map("user")
  @@schema("public")
}

/// A personal token that lets something other than a browser act as this user.
///
/// Every operation in this app is authenticated by a session cookie, which is the
/// right default and rules out the one client that now needs in: an MCP host. A
/// coding agent in somebody's editor cannot hold a cookie, and the `sameSite`
/// protection that makes cookies safe is exactly what stops it.
///
/// So this is the second identity, and it is deliberately narrower than a session.
/// A session is issued by GitHub's OAuth flow and carries whatever the person can
/// do; a token is issued by the person, named by them, scoped, expirable, and
/// individually revocable — which matters because it will end up in a plain-text
/// config file on a laptop, and those get committed, synced and shared.
///
/// Hashed, not encrypted. `SecretBox` exists for MCP auth headers and is the wrong
/// tool here: those are credentials for somebody else's system and have to be
/// replayed, so they must be recoverable. This one is only ever compared against,
/// so the plaintext is shown once at creation and then nowhere — a database dump
/// reveals no usable token, and there is no key whose loss would matter.
model ApiToken {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// What the person calls it, e.g. "VS Code on the laptop".
  ///
  /// The only way to tell two tokens apart when deciding which to revoke, since the
  /// secret itself is unreadable after creation.
  name String @db.Text

  /// SHA-256 of the token, hex.
  ///
  /// Unhashed lookup is the point: a plain hash rather than bcrypt or argon2,
  /// because this is a 256-bit random string and not a password. There is no
  /// dictionary to attack and no user-chosen entropy to stretch, so a slow KDF would
  /// only add latency to every request — and a fast hash keeps the lookup a single
  /// indexed equality instead of a scan over every row.
  tokenHash String @unique @map("token_hash") @db.Text

  /// The first characters of the token, shown so a person can recognise it.
  ///
  /// Not a secret: the useful part is unrecoverable, and without this the settings
  /// screen can only offer a name somebody chose months ago.
  tokenPrefix String @map("token_prefix") @db.Text

  /// What this token may do, coarse: "read" or "write".
  ///
  /// Two values rather than a permission per operation. The distinction that matters
  /// is whether a leak can change somebody's infrastructure, and a scope per tool
  /// would be a lot of surface for a difference nobody reasons about. "write"
  /// implies "read".
  scopes String[] @default(["read"])

  /// When it stops working, or null for a token that never expires.
  ///
  /// Nullable rather than required so the honest case is representable: a token for a
  /// long-lived workstation setup that nobody will remember to rotate is better named
  /// as such than given a fake expiry the person will extend without thinking.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  /// When it was last accepted, to the minute.
  ///
  /// Coarse on purpose: this is here so somebody can find the token they stopped
  /// using and revoke it, not to trace activity — that is what the audit trail is
  /// for. Writing it per request would also mean a write on every read path.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  /// Set instead of deleting the row, so a revoked token cannot be recreated by
  /// chance and so the audit trail keeps something to point at.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Names are unique per person, so "which one is that?" has an answer.
  @@unique([userId, name])
  @@index([userId])
  @@map("api_tokens")
  @@schema("public")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime @db.Timestamptz(6)
  token     String   @unique @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String    @db.Uuid
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

/// Organisation-wide defaults. Scoped per user like every other model here,
/// because the app has no tenant entity: a shared singleton would let one user
/// silently overwrite another's conventions.
model CompanySettings {
  id                      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String  @unique @map("user_id") @db.Uuid
  name                    String  @default("") @db.Text
  /// Repository-relative folder that holds one subfolder per submodule, e.g.
  /// `modules`. Used to pre-select submodules when importing from Git.
  terraformSubmodulesPath String? @map("terraform_submodules_path") @db.Text
  /// Default Terraform root folder offered by the import wizard, e.g. `.`.
  terraformRootFolder     String? @map("terraform_root_folder") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("company_settings")
  @@schema("public")
}

/// A project is a Terraform root configuration that lives in a Git repository.
/// The repository is the source of truth: the graph is derived from its `.tf`
/// files and every graph edit is written back as a commit. A project without a
/// repository would have nothing to render, so the binding is created together
/// with the project and never cleared.
model Project {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String  @db.Text
  description String? @db.Text

  provider            String  @default("github") @db.Text
  /// `owner/name`, the only repository identifier GitHub's API accepts.
  repoFullName        String  @map("repo_full_name") @db.Text
  repoUrl             String? @map("repo_url") @db.Text
  repoBranch          String  @default("main") @map("repo_branch") @db.Text
  /// Repository-relative folder holding the root configuration, e.g. `.`.
  terraformRootFolder String  @default(".") @map("terraform_root_folder") @db.Text
  /// File that new `module` blocks are appended to.
  terraformEntryFile  String  @default("main.tf") @map("terraform_entry_file") @db.Text

  /// The application this infrastructure is being built for, as `owner/name`.
  ///
  /// Optional and read-only to us: Terrablox never writes to it. Infrastructure
  /// that fits an application has to be derived from how that application is
  /// actually built — its runtime, its ports, its data stores — and that is in
  /// its repository rather than in anything the user would think to type into a
  /// chat box. Null means the project was never linked to one, which is a
  /// working project, just one the agent has to ask about instead of read.
  appRepoFullName String? @map("app_repo_full_name") @db.Text
  /// Ref the application is read at. Null falls back to the default branch.
  appRepoBranch   String? @map("app_repo_branch") @db.Text

  /// Node positions keyed by the `module` block label. Layout is presentation,
  /// not configuration, so it stays out of the repository.
  graphPositions Json @default("{}") @map("graph_positions") @db.JsonB

  /// Agent settings this project overrides, as `{ model?, reasoningEffort?,
  /// skills?, disabledTools? }`. A key that is absent inherits the user's
  /// global setting, which is why this is JSON: Prisma cannot express a
  /// nullable `String[]`, and "inherit" has to be distinguishable from "empty".
  agentOverrides Json? @map("agent_overrides") @db.JsonB

  /// Commit the graph was last built from, used to detect outside changes.
  lastSyncedSha String?   @map("last_synced_sha") @db.Text
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)

  /// True while the agent is processing a turn. Survives navigation and page
  /// reloads so the UI knows it should show a spinner even after a re-mount.
  agentRunning Boolean @default(false) @map("agent_running")

  /// What the running turn has done so far, as the same `AgentStep[]` the
  /// finished message stores in its metadata.
  ///
  /// Written while the turn runs so the chat can show progress instead of a
  /// spinner that says nothing for two minutes. On the project rather than on a
  /// message because there is no message to attach it to yet — the assistant's
  /// reply is only written when the turn ends. Cleared when it does.
  agentSteps Json? @map("agent_steps") @db.JsonB

  /// Deployment target. No credentials are stored: the pipeline assumes an IAM
  /// role through GitHub's OIDC provider, so the role's ARN is all that is
  /// needed and it is safe to commit into the workflow.
  awsAccountId   String? @map("aws_account_id") @db.Text
  awsRegion      String  @default("eu-central-1") @map("aws_region") @db.Text
  awsRoleArn     String? @map("aws_role_arn") @db.Text
  /// S3 backend for the Terraform state. Without one, every pipeline run starts
  /// from an empty state and tries to create the whole stack again.
  stateBucket    String? @map("state_bucket") @db.Text
  stateLockTable String? @map("state_lock_table") @db.Text
  /// Customer-managed KMS key the state bucket encrypts with. Needed by both
  /// sides: the pipeline writes the state through it, and reading the inventory
  /// back requires `kms:Decrypt` on this exact key.
  stateKmsKeyArn String? @map("state_kms_key_arn") @db.Text
  /// The CloudFormation stacks that own the two halves of the bootstrap, and the
  /// KMS alias inside the second one.
  ///
  /// Stored rather than derived from `name`, which is what they used to be. A
  /// derived name is only stable while the name is, and a project can be renamed:
  /// after one, `DescribeStacks` looked for a stack nobody had created, the wizard
  /// concluded the setup was unfinished, and the create it then offered failed on
  /// `EntityAlreadyExists` — because the role name is recovered from the stored
  /// ARN and was therefore still the old one. With `OnFailure: DELETE` that took
  /// the new stack down again, leaving a loop with no way out of it in the UI.
  ///
  /// Set once, on the first apply, and never recomputed — the same rule the bucket
  /// and the lock table above already follow. It makes a rename cosmetic, which is
  /// what a rename should be.
  roleStackName  String? @map("role_stack_name") @db.Text
  stateStackName String? @map("state_stack_name") @db.Text
  stateKmsAlias  String? @map("state_kms_alias") @db.Text

  /// Which deployment workflow templates this project uses and how they are
  /// configured, as `{ disabled?: string[], terraformVersion?, requireApproval?,
  /// scheduleRefresh? }`. JSON for the same reason `agentOverrides` is: a key
  /// that is absent has to mean "use the catalogue default", which is not the
  /// same as an empty value.
  deployTemplates Json? @map("deploy_templates") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  canvasNodes     CanvasNode[]
  connections     Connection[]
  chatMessages    ProjectChatMessage[]
  operations      ProjectOperation[]
  decisions       ProjectDecision[]
  transformations ProjectTransformation[]

  @@index([userId])
  @@map("projects")
  @@schema("public")
}

/// One agent turn captured whole, as training data for the harness.
///
/// Everything else about a turn is spread across three places and shaped for the
/// UI: the reply and step trail on a {@link ProjectChatMessage}, the reasoning on
/// {@link ProjectDecision}, the applied edits on {@link ProjectOperation}. None of
/// them keeps the graph the turn *started* from, so the before/after pair — the
/// transformation itself — cannot be reconstructed after the fact. This row is the
/// one place that holds it: the prompt and the conditions it ran under, the graph
/// before and after, the trajectory in between, and an outcome signal filled in
/// once the pipeline has judged the commit.
///
/// Written fire-and-forget after the turn commits, so a failure here never costs
/// the turn. Only turns that changed something are recorded; a pure question has
/// no transformation to learn from. Users are told their projects are used this
/// way, so nothing here is redacted.
model ProjectTransformation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid

  /// The assistant message this turn produced, so the record can be joined back
  /// to the transcript. Null if the message was pruned.
  chatMessageId String? @map("chat_message_id") @db.Uuid

  /// What the user asked for.
  prompt String @db.Text
  /// The assistant's reply.
  reply  String @db.Text

  /// The conditions the turn ran under: `{ model, reasoningEffort, maxToolCalls,
  /// maxSteps, allowDestructive, disabledTools, disabledKnowledge, seesRepo,
  /// seesLibrary, historyChars }`. Kept because the same prompt under a different
  /// model or budget is a different example.
  settings Json @default("{}") @db.JsonB

  /// The project graph before the turn: `{ nodes, edges, gaps, resourceCount,
  /// files, sha, errors }`, the `ProjectGraph` shape. The "ist-zustand".
  graphBefore Json @default("{}") @map("graph_before") @db.JsonB
  /// The project graph after every mutation of the turn was applied. The "fertig
  /// migrierter zustand". Equal to `graphBefore` when nothing committed, which is
  /// why such turns are not recorded.
  graphAfter  Json @default("{}") @map("graph_after") @db.JsonB

  /// The trajectory: the complete `AgentStep[]` trail, thoughts and tool calls in
  /// order, untrimmed. The UI's capped and truncated copy lives on the assistant
  /// message instead; this one is the faithful record for training.
  steps     Json @default("[]") @db.JsonB
  /// The `ProjectGraphMutation[]` the turn queued, in order.
  mutations Json @default("[]") @db.JsonB
  /// The decisions the turn recorded: question, choice, reason, alternatives, plan.
  decisions Json @default("[]") @db.JsonB

  /// What the turn migrated FROM, when its starting state was not the graph.
  ///
  /// `{ kind, appRepo?: { fullName, branch, sha }, appRepoReads: [...], mcpCalls:
  /// [...] }`. `kind` is `greenfield` (empty before-graph, no external source),
  /// `graph` (built on the existing graph, no external source) or `legacy` (read an
  /// app repo or an MCP server — a real migration). The app-repo files are captured
  /// as the agent saw them, capped; MCP calls carry args and, where the SDK allows,
  /// results. Empty reads with a non-empty before-graph is `graph`; empty reads with
  /// an empty before-graph is `greenfield`. This is the half a graph-to-graph record
  /// cannot hold: the on-prem or legacy state a migration actually starts from.
  migrationSource Json @default("{}") @map("migration_source") @db.JsonB

  /// The commit SHAs the turn produced, oldest first.
  commits        String[] @default([]) @db.Text
  /// Mutation errors the turn hit, each a human-readable sentence. Empty is clean.
  mutationErrors String[] @default([]) @map("mutation_errors") @db.Text

  /// completed | stopped | error. A stopped turn commits nothing and is not
  /// recorded, so in practice this is `completed`; the column exists so a future
  /// decision to record partial turns has somewhere to say so.
  outcome String @default("completed") @db.Text

  /// The verdict the project's pipeline reached on these commits, backfilled on a
  /// later turn when `readLastCheck` reports on this branch: `success`, `failure`,
  /// null while unknown. This is the label — did the transformation produce valid
  /// Terraform — and it is why the record is worth keeping.
  pipelineConclusion String?   @map("pipeline_conclusion") @db.Text
  pipelineCheckedAt  DateTime? @map("pipeline_checked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("project_transformations")
  @@schema("public")
}

/// One applied graph edit.
///
/// The repository is still the source of truth; this is the index into it. Each
/// row keeps the commit the edit produced and the commit it replaced, so a
/// later "jump to this point" can restore a state without replaying anything or
/// trusting that the rows in between are complete.
model ProjectOperation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// Who made the edit: `canvas` or `agent`.
  origin String @db.Text
  /// The mutation exactly as applied. Kept verbatim so an entry stays readable
  /// even after the mutation format grows a field.
  mutation Json @db.JsonB
  /// The commit message, which already describes the edit in the user's terms.
  summary String @db.Text

  /// Commit this edit produced, and the branch head it was applied on top of.
  /// Null when GitHub reported no commit, e.g. an edit that changed nothing.
  commitSha String? @map("commit_sha") @db.Text
  parentSha String? @map("parent_sha") @db.Text

  /// The turn that produced this edit, and the decision it serves.
  ///
  /// Both null for a canvas edit, which is one gesture and needs no grouping, and
  /// null on every row written before these columns existed. Until they did, the
  /// only way to tell which operations belonged together was to intersect commit
  /// shas with an assistant message's metadata — so "the agent added ten modules
  /// and then ran out of budget" was a sentence nobody could reconstruct.
  chatMessageId String? @map("chat_message_id") @db.Uuid
  decisionId    String? @map("decision_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Set null rather than cascade: losing the conversation must not lose the
  /// record of what reached the repository.
  chatMessage ProjectChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  decision    ProjectDecision?    @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([chatMessageId])
  @@index([decisionId])
  @@map("project_operations")
  @@schema("public")
}

/// Why the infrastructure looks the way it does, in the words of whoever decided.
///
/// The operation log answers "what changed, when". This answers the question the
/// operation log structurally cannot: *why*. They are different grains — one turn
/// of the agent produced one decision about where the application's data lives and
/// twenty-nine operations implementing it — so grouping the operations differently
/// would not have produced this, and reading the reason back out of them is not
/// possible at all.
///
/// Shaped after an architecture decision record, and for its reasons: the context
/// and the alternatives are the parts worth keeping, and a decision is never
/// edited to reflect a change of mind — a later one supersedes it, so the log
/// keeps saying what was believed at the time.
///
/// What it is not: a fact. A decision the agent records is the agent's own account
/// of what it understood and chose, which is exactly why `context` is a column of
/// its own. A misread requirement is visible there before it becomes
/// infrastructure, and `origin` says whose account this is.
model ProjectDecision {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid

  /// Who recorded it: `agent` or `user`.
  origin String @db.Text

  /// What was being decided, as a heading. "Where the application's data lives."
  question String @db.Text
  /// The requirements and constraints in force, as understood at the time.
  ///
  /// ADR calls this the context, and it is the field a reader corrects first:
  /// "self-hosted, containers, managed document database, test environment,
  /// publicly reachable" is a reading of a conversation, not a fact about it.
  context String @db.Text
  /// What was decided.
  choice String @db.Text
  /// Why, in terms a reader can disagree with.
  reason String @db.Text
  /// What was weighed and rejected, each with the reason it lost.
  alternatives Json @default("[]") @db.JsonB

  /// The intended shape: modules to add and wires to draw, as declared.
  ///
  /// Kept separate from the operations that followed, because the difference is
  /// the interesting part — a plan naming ten modules and nine wires next to a
  /// turn that queued ten and none is the whole story of that turn.
  plan Json @default("{}") @db.JsonB

  /// `active` or `superseded`.
  status         String  @default("active") @db.Text
  supersededById String? @map("superseded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Self-relation: the decision that replaced this one, and what it replaced.
  supersededBy ProjectDecision?  @relation("DecisionSupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   ProjectDecision[] @relation("DecisionSupersedes")
  operations ProjectOperation[]

  @@index([projectId, createdAt])
  @@map("project_decisions")
  @@schema("public")
}

/// A connected AWS account, used for reading only.
///
/// In `assume-role` mode no credentials are kept at all. Terrablox assumes a role
/// the customer created in their own account and gets a short-lived session for
/// the length of one request. The external ID is what makes that safe: without
/// it, anyone who learned the role ARN could ask Terrablox to assume it on their
/// behalf, which is the confused-deputy problem AWS documents for exactly this
/// kind of integration. It is deliberately *not* encrypted — the user is shown it
/// so they can write it into a trust policy themselves, and on its own it grants
/// nothing: only this app's AWS principal can present it.
///
/// In `sso` mode there is a credential, and it is encrypted. See below.
model AwsConnection {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// What the user calls this account, e.g. "Production".
  label      String  @default("") @db.Text
  /// Filled in from sts:GetCallerIdentity, never typed by the user.
  accountId  String? @map("account_id") @db.Text
  roleArn    String  @map("role_arn") @db.Text
  region     String  @default("eu-central-1") @db.Text
  /// Generated by Terrablox, must appear in the role's trust policy.
  externalId String  @map("external_id") @db.Text

  /// How credentials are obtained: `assume-role` or `sso`.
  ///
  /// Assuming a role needs Terrablox to have an AWS identity of its own to be
  /// named in the trust policy, which a self-hosted instance usually has not.
  /// Those instances keep the IAM Identity Center session instead and exchange
  /// it for role credentials per request, exactly as the AWS CLI does — no app
  /// identity required, at the cost of a session the user has to renew.
  credentialMode String @default("assume-role") @map("credential_mode") @db.Text

  /// Set only in `sso` mode. The token is short-lived by design; it is the
  /// reason this mode asks the user to sign in again every few hours.
  ssoStartUrl String? @map("sso_start_url") @db.Text
  ssoRegion   String? @map("sso_region") @db.Text
  ssoRoleName String? @map("sso_role_name") @db.Text

  /// The IAM Identity Center access token, AES-256-GCM encrypted.
  ///
  /// A bearer credential for every AWS account this person can reach: whoever
  /// holds it can issue role credentials in any of them until it expires. Short
  /// lived is not the same as harmless — a database dump taken inside those hours
  /// would be enough to act as the user in their own accounts — so it is
  /// encrypted at rest like the MCP headers, and for the same reason.
  ///
  /// Undecryptable is treated as expired rather than as an error: a row written
  /// under an older BETTER_AUTH_SECRET is unusable, and signing in again is the
  /// cure the user already knows for that state.
  ssoAccessTokenCiphertext String? @map("sso_access_token_ciphertext") @db.Text

  ssoExpiresAt DateTime? @map("sso_expires_at") @db.Timestamptz(6)

  /// Null until the role could actually be assumed. A connection is only
  /// trusted for reads once this is set.
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  /// Why the last verification failed, so the UI can explain it.
  lastError  String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleArn])
  @@index([userId])
  @@map("aws_connections")
  @@schema("public")
}

/// Transcript of the project agent conversation. Persisted per project because
/// the agent's context is the repository, so a conversation is only meaningful
/// next to the project it edited.
/// A device authorization in flight, and the SSO session it produces.
///
/// Kept server-side rather than handed to the browser because the device code
/// and the client secret are what redeem the login: anyone holding them could
/// claim the session the user is about to approve. The row is deleted as soon
/// as the connection is set up, so the SSO token is never a long-lived secret.
///
/// Every value here that can be redeemed is encrypted at rest as well. Deleting
/// the row promptly bounds who can reach it in the future; encryption bounds what
/// a copy of the database is worth, and those are different exposures.
model AwsSsoLogin {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The customer's IAM Identity Center portal, e.g. https://acme.awsapps.com/start.
  startUrl  String @map("start_url") @db.Text
  /// Region the Identity Center instance lives in, not the target region.
  ssoRegion String @map("sso_region") @db.Text

  /// Not a secret: a public client registration id, which is why it is the one
  /// field of this row stored as it is.
  clientId String @map("client_id") @db.Text

  /// The two halves of the redemption, AES-256-GCM encrypted.
  ///
  /// Together they are the login: `CreateToken` takes the client secret and the
  /// device code and returns the access token, so anyone holding both can claim
  /// the session the moment the user approves it in their browser. The row is
  /// deleted within fifteen minutes either way, but "short lived" is a property
  /// of the window and not of the value, and a dump taken inside it should not be
  /// enough to hijack an approval.
  clientSecretCiphertext String @map("client_secret_ciphertext") @db.Text
  deviceCodeCiphertext   String @map("device_code_ciphertext") @db.Text

  /// Seconds AWS asks us to wait between polls.
  interval Int @default(5)

  /// Set once the user approves in the browser, AES-256-GCM encrypted.
  ///
  /// The same token that later moves to the connection row, so it is protected
  /// the same way here — it is at its most valuable in exactly this window,
  /// before anything has narrowed what it may do.
  accessTokenCiphertext String? @map("access_token_ciphertext") @db.Text

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("aws_sso_logins")
  @@schema("public")
}

model ProjectChatMessage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  /// One of "user", "assistant" or "system".
  role      String @db.Text
  content   String @db.Text
  /// What the turn changed, e.g. `{"commits":[{"sha":"…","path":"main.tf"}]}`.
  /// Kept so the UI can show the effect of a turn without re-reading the repo.
  metadata  Json   @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operations ProjectOperation[]

  @@index([projectId, createdAt])
  @@map("project_chat_messages")
  @@schema("public")
}

/// A repository a module was imported from.
///
/// `userId` is NULL for the catalogue Terrablox ships with. Those rows belong to
/// the installation rather than to a person: every user sees them, nobody owns
/// them, and no user can edit or delete them. Read paths therefore have to match
/// `userId = <me> OR userId IS NULL`, while write and delete paths keep matching
/// a plain string — Prisma never matches NULL with an equality filter, which is
/// what makes builtins immutable without a single extra guard.
model TerraformModuleSource {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  name        String   @db.Text
  description String?  @db.Text
  tags        String[] @default([]) @db.Text
  url         String   @db.Text
  provider    String   @default("github") @db.Text

  /// Raw URL of an `icon.png` found in the repository at import time.
  ///
  /// Served through our own route rather than linked directly: a private
  /// repository's raw URL needs a token, and a browser hitting it unauthenticated
  /// would fall back to the default icon without ever saying why.
  iconUrl String? @map("icon_url") @db.Text

  /// A bundled AWS icon chosen by hand at import, by file name without the
  /// extension, e.g. `eks`. Independent of `iconUrl`: one is what the repository
  /// brings, the other is what the user picked, and either can exist alone.
  iconName String? @map("icon_name") @db.Text

  /// Which of the two the module actually shows: `repo`, `aws` or `none`.
  ///
  /// A choice rather than a cascade, so that "use the plain mark" and "use the
  /// AWS one even though the repository ships a picture" are both sayable. Each
  /// mode names exactly one source and falls back to the neutral mark if that
  /// source is missing — it never quietly shows the other one.
  ///
  /// Defaults to `repo`, which is what every row did before this column existed.
  iconMode String @default("repo") @map("icon_mode") @db.Text

  /// The module library this source was synced from, e.g. `terrablox`, `porsche`.
  ///
  /// NULL only for a user's own import. A global library row has no `userId` and
  /// a library; a per-user library row has both (each user's own copy, resolved
  /// with their own token). A CHECK constraint forbids rows with neither. Library
  /// rows are managed by the sync and read-only to users, and a library's
  /// `visible` flag in TERRABLOX_MODULE_LIBRARIES hides them from every read
  /// path; see lib/module-library/ownership.ts.
  library String? @db.Text

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions   TerraformModule[]
  librarySync ModuleLibrarySync? @relation("ModuleSourceLibrarySync", fields: [userId, library], references: [userId, library], onDelete: Cascade)

  @@index([userId, library])
  @@map("terraform_module_sources")
  @@schema("public")
}

/// Where one person's copy of a per-user module library has got to.
///
/// One row per (user, library). Holds staleness, a short lock so two tabs don't
/// sync at once, and what discovery last learned — enough to show an install hint
/// without asking GitHub on every page load.
model ModuleLibrarySync {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// Library id from TERRABLOX_MODULE_LIBRARIES, e.g. `porsche`.
  library        String    @db.Text
  /// never | available | not-installed | no-repos | error
  state          String    @default("never") @db.Text
  /// Text, not Int: GitHub ids are not guaranteed to stay below 2^31.
  installationId String?   @map("installation_id") @db.Text
  memberDetected Boolean   @default(false) @map("member_detected")
  /// `{ [repoFullName]: { branch, branchSha, tag } }` as last imported.
  repos          Json      @default("{}") @db.JsonB
  /// Discovery finished but some repos are still waiting to be imported.
  pending        Boolean   @default(false)
  /// Fences an expired worker from publishing or clearing a newer worker's sync.
  lockId         String?   @map("lock_id") @db.Uuid
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  /// Last discovery GitHub answered authoritatively.
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleSources TerraformModuleSource[] @relation("ModuleSourceLibrarySync")
  modules       TerraformModule[]       @relation("ModuleLibrarySync")

  @@unique([userId, library])
  @@map("module_library_syncs")
  @@schema("public")
}

/// One analysed ref of a repository, or one of its submodule folders.
///
/// `userId` is NULL for the catalogue Terrablox ships with; see
/// {@link TerraformModuleSource} for what that implies for queries.
model TerraformModule {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String?  @map("user_id") @db.Uuid
  /// Optional display name for submodules. Root module name/description live on TerraformModuleSource.
  submoduleName              String?  @map("submodule_name") @db.Text
  versionTag                 String?  @map("version_tag") @db.Text
  url                        String?  @db.Text
  sourceId                   String?  @map("source_id") @db.Uuid
  terraformRootFolder        String?  @map("terraform_root_folder") @db.Text
  terraformSubmodulesFolders String[] @default([]) @map("terraform_submodules_folders") @db.Text
  variables                  Json     @default("[]") @db.JsonB
  outputs                    Json     @default("[]") @db.JsonB
  /// `locals` blocks, merged across files, as `{ name, expression, file }`.
  ///
  /// Kept because a module's `count` expressions are written against them:
  /// `count = local.create_public_subnets ? local.len_public_subnets : 0` cannot
  /// be resolved from variables alone, and without resolving it the architecture
  /// diagram has to draw every optional block as if it existed.
  locals                     Json     @default("[]") @db.JsonB
  isSubmodule                Boolean  @default(false) @map("is_submodule")
  parentModuleId             String?  @map("parent_module_id") @db.Uuid
  /// Denormalised from the source, like `userId`, so one ownership fragment fits both models.
  library                    String?  @db.Text
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source       TerraformModuleSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  librarySync  ModuleLibrarySync?      @relation("ModuleLibrarySync", fields: [userId, library], references: [userId, library], onDelete: Cascade)
  parentModule TerraformModule?       @relation("ModuleHierarchy", fields: [parentModuleId], references: [id], onDelete: SetNull)
  submodules   TerraformModule[]      @relation("ModuleHierarchy")
  resources    ProviderResource[]
  dependencies ModuleDependency[]
  providers    ModuleProvider[]
  references   ResourceReference[]
  canvasNodes  CanvasNode[]
  graphLayouts ModuleGraphLayout[]

  @@unique([sourceId, versionTag, terraformRootFolder])
  @@index([userId, library])
  @@map("terraform_modules")
  @@schema("public")
}

/// A reference from one block of a module to another, e.g. `aws_nat_gateway.this`
/// using `aws_subnet.public[*].id`. Endpoints are stored as Terraform addresses
/// rather than foreign keys because a reference may legitimately point at a
/// module call, which is not a row in provider_resources.
model ResourceReference {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String   @map("module_id") @db.Uuid
  /// Address of the dependent block, e.g. `aws_nat_gateway.this`.
  fromAddress String   @map("from_address") @db.Text
  /// One of "resource", "data" or "module".
  fromKind    String   @map("from_kind") @db.Text
  /// Address of the block being depended on, e.g. `aws_subnet.public`.
  toAddress   String   @map("to_address") @db.Text
  toKind      String   @map("to_kind") @db.Text
  /// Attributes of the dependent block that produced the edge, e.g. `subnet_id`.
  attributes  String[] @default([]) @db.Text
  /// Locals the reference was routed through, if any.
  viaLocals   String[] @default([]) @map("via_locals") @db.Text

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, fromAddress, toAddress])
  @@index([moduleId])
  @@map("resource_references")
  @@schema("public")
}

model CanvasNode {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  moduleId      String   @map("module_id") @db.Uuid
  name          String   @db.Text
  positionX     Float    @default(0) @map("position_x") @db.DoublePrecision
  positionY     Float    @default(0) @map("position_y") @db.DoublePrecision
  width         Float?   @default(200) @db.DoublePrecision
  height        Float?   @default(150) @db.DoublePrecision
  configuration Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module            TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  sourceConnections Connection[]    @relation("SourceNode")
  targetConnections Connection[]    @relation("TargetNode")

  @@map("canvas_nodes")
  @@schema("public")
}

/// User-adjusted node positions for a module's connection graph. Stored as one
/// row per module rather than one per node: the graph is always read and
/// written as a whole, and node identity is the Terraform address, not a row id.
model ModuleGraphLayout {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  moduleId  String @map("module_id") @db.Uuid
  /// Which of the module's diagrams these positions belong to. A module has
  /// more than one, and their node ids are unrelated — without this they would
  /// share a row and overwrite each other.
  graph     String @default("connections")
  /// Map of node id to `{ x, y }`, e.g. `{"aws_vpc.this":{"x":0,"y":40}}`.
  /// Ids that no longer exist are ignored on read, so a re-import cannot
  /// strand the layout.
  positions Json   @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, graph])
  @@map("module_graph_layouts")
  @@schema("public")
}

model Connection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  sourceNodeId String   @map("source_node_id") @db.Uuid
  sourceOutput String   @map("source_output") @db.Text
  targetNodeId String   @map("target_node_id") @db.Uuid
  targetInput  String   @map("target_input") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceNode CanvasNode @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode CanvasNode @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@map("connections")
  @@schema("public")
}

model ProviderResource {
  id                  String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId            String  @map("module_id") @db.Uuid
  /// Either "resource" or "data". Terraform treats data sources as a distinct
  /// block type and they must not be presented as managed resources.
  kind                String  @default("resource") @db.Text
  resourceType        String  @map("resource_type") @db.Text
  resourceName        String? @map("resource_name") @db.Text
  providerName        String  @map("provider_name") @db.Text
  version             String? @db.Text
  sourceFile          String? @map("source_file") @db.Text

  /// The `count` or `for_each` expression that decides whether this block exists,
  /// or NULL when it is always created.
  ///
  /// Stored because reading HCL is not reading a plan. The upstream VPC module
  /// writes its public route for the database subnet as
  /// `count = var.create_database_internet_gateway_route ? 1 : 0`, so the code
  /// contains a route to an internet gateway that a default deployment does not
  /// create — and the architecture diagram was calling that subnet public as a
  /// statement of fact. The expression rather than a boolean, so the UI can name
  /// the variable someone would have to check.
  conditionalOn       String? @map("conditional_on") @db.Text

  /// The `availability_zone` argument, as written, or NULL when the block has none.
  ///
  /// Kept for the same reason as {@link conditionalOn}: it is an expression, not a
  /// value, and evaluating it is what turns `count = 2` into two named subnets.
  /// The upstream modules all write it as `element(var.azs, count.index)`, so with
  /// the caller's zone list and the instance index bound it resolves to
  /// `eu-central-1a` — which is the label that makes two subnet frames mean
  /// something rather than being `[0]` and `[1]`.
  availabilityZone    String? @map("availability_zone") @db.Text

  resourceUrl         String? @map("resource_url") @db.Text
  providerUrl         String? @map("provider_url") @db.Text
  resourceDescription String? @map("resource_description") @db.Text

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@map("provider_resources")
  @@schema("public")
}

/// A `module "x" { source = ... }` call found inside a module. These are the
/// edges of the dependency graph and were previously analysed but discarded.
model ModuleDependency {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId    String  @map("module_id") @db.Uuid
  /// Block label, i.e. the `x` in `module "x"`.
  name        String  @db.Text
  source      String? @db.Text
  version     String? @db.Text
  /// One of "local", "registry", "git" or "unknown".
  sourceKind  String  @default("unknown") @map("source_kind") @db.Text
  registryUrl String? @map("registry_url") @db.Text
  sourceFile  String? @map("source_file") @db.Text

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, name])
  @@index([moduleId])
  @@map("module_dependencies")
  @@schema("public")
}

/// A provider requirement declared via `required_providers` or a bare
/// `provider` block, kept separately so versions survive the import.
model ModuleProvider {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId String  @map("module_id") @db.Uuid
  /// Local name used as the resource type prefix, e.g. `aws`.
  name     String  @db.Text
  /// Registry source such as `hashicorp/aws`.
  source   String? @db.Text
  /// Version constraint such as `~> 5.0`.
  version  String? @db.Text
  docsUrl  String? @map("docs_url") @db.Text

  module TerraformModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, name])
  @@index([moduleId])
  @@map("module_providers")
  @@schema("public")
}

/// How one person wants the project agent to behave.
///
/// Per user rather than per project: the agent runs on the user's own Copilot
/// licence, so the person who pays for the turn is the one who gets to shape
/// it. Two colleagues on the same project can differ here.
model AgentSettings {
  userId String @id @map("user_id") @db.Uuid

  /// Free text appended to the system prompt, e.g. house naming rules.
  /// Length is capped in the service, not here, so the limit stays reviewable.
  instructions String @default("") @db.Text

  /// Copilot model id for this user's turns. Null means "auto", which lets
  /// Copilot pick whatever the person is actually entitled to.
  model           String? @db.Text
  /// How hard the model should think, for models that support it. Null leaves
  /// the model's own default alone.
  reasoningEffort String? @map("reasoning_effort") @db.Text

  /// Tools the agent may not call, by name. A deny list rather than an allow
  /// list, so a tool we add later works without every user re-saving.
  disabledTools String[] @default([]) @map("disabled_tools")

  /// Knowledge sources withheld from the agent, by id. A deny list for the same
  /// reason `disabledTools` is one, and for a second: an allow list cannot tell
  /// "this user has never opened the settings" apart from "this user switched
  /// everything off", so a new install would start with an agent that can see
  /// neither its module library nor the project it is editing.
  disabledKnowledge String[] @default([]) @map("disabled_knowledge")

  /// How long a single turn may run, in seconds. Null means use the default,
  /// which is also the ceiling (1800 = 30 min): the limit exists to stop a stuck
  /// turn, so it is generous by default and only turns down.
  turnTimeout Int? @map("turn_timeout")

  /// How many operations one turn may queue. Null means the default (100).
  ///
  /// Every queued operation becomes a commit after the turn, so this is the size
  /// of the largest change one unreviewed turn can make. Lowering it to 1 makes
  /// the agent report back after every edit; raising it suits large projects.
  maxToolCalls Int? @map("max_tool_calls")

  /// How many MCP tool calls one turn may make. Null means the default (100).
  ///
  /// Counted apart from `maxToolCalls` because the risks differ: an operation
  /// changes the user's repository, while an MCP call is a read from somebody
  /// else's server on whatever credential is stored with it.
  maxMcpCalls Int? @map("max_mcp_calls")

  /// How much of a project's conversation is replayed into a turn, in characters.
  /// Null means the default (24000).
  ///
  /// The agent's long-term memory, and the only setting for it: the world state is
  /// re-read from Git every turn, so this covers what was *said* rather than what
  /// exists. A budget in characters rather than a message count, because eight
  /// short answers and eight long ones are not the same amount of context.
  historyBudgetChars Int? @map("history_budget_chars")

  /// How many entries of one turn are recorded. Null means the default (500).
  ///
  /// A cap on the record, not on the turn: past it the entry is dropped and the
  /// turn carries on. It is a setting because the row is read back by everyone who
  /// opens the transcript — someone running long turns wants more of it than we
  /// guessed, someone on a slow connection wants less, and both are answers about
  /// their own transcript. The reasoning-summary cap is derived from this rather
  /// than stored, so the two can never contradict each other.
  maxSteps Int? @map("max_steps")

  /// How many times one turn may read the linked application repository. Null
  /// means the default (40).
  ///
  /// Apart from `maxToolCalls` because reads commit nothing — spending the
  /// operation budget on looking would leave a turn that studied an application
  /// carefully with nothing left to build with. It still needs its own ceiling:
  /// every read is a GitHub request against the user's rate limit.
  maxAppRepoReads Int? @map("max_app_repo_reads")

  /// How many paths one application-repository listing returns. Null means the
  /// default (400).
  ///
  /// Raising it is the honest answer for a large monorepo, where narrowing the
  /// path — the intended remedy — needs a first listing broad enough to show which
  /// subtree to narrow to.
  appRepoTreeLimit Int? @map("app_repo_tree_limit")

  /// How much of one application file is handed to the model, in characters. Null
  /// means the default (20000).
  appRepoFileChars Int? @map("app_repo_file_chars")

  /// Whether the agent may call the operations that delete a module or a
  /// variable, along with every reference to them.
  ///
  /// Off by default, and a real column rather than a sentence in the prompt: the
  /// prompt used to ask the agent to check first, which it cannot be made to do —
  /// permission prompts are auto-approved because the turn runs headless. Off, the
  /// destructive operations are never registered on the session at all.
  ///
  /// Not a deny list like the two above: a default of "allowed" is exactly what
  /// this setting exists to avoid.
  allowDestructive Boolean @default(false) @map("allow_destructive")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_settings")
  @@schema("public")
}

/// Editable overrides for harness texts that would otherwise only live in code.
///
/// One row, one JSON object. The alternative — a column or a table per curated
/// list — would mean a schema migration every time a sentence becomes editable,
/// and the reader has to validate the JSON defensively either way because it
/// outlives any one version of the code.
///
/// Only overrides are stored. The defaults are in the source, so an empty table
/// behaves exactly like the code and deleting the row is a working undo. What is
/// *not* here is deliberate: which operations exist, their JSON schemas, and the
/// enforcement class of each harness element stay in code, because those are
/// claims about what the code does rather than preferences about wording.
/// One person's harness wording overrides.
///
/// Keyed by user, and that is the whole point. This used to be a single row with
/// a fixed id, which made the harness an installation-wide setting that any
/// signed-in account could rewrite — and because `getHarnessCuration` feeds the
/// operating rules straight into the agent's system prompt, that was a way to put
/// text into *other* people's agent runs. There is no role model here and no
/// tenant entity, so per user is the only scope that is actually enforceable.
///
/// An absent row means "the code defaults", exactly as an empty override object
/// does, so a new user needs nothing created for them.
model HarnessCuration {
  userId    String   @id @map("user_id") @db.Uuid
  overrides Json     @default("{}") @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("harness_curation")
  @@schema("public")
}

/// Security-relevant things that happened, for reading after the fact.
///
/// Separate from `ProjectOperation`, which records what the agent did to a graph:
/// that is product history, shown in the UI and scoped to a project. This is the
/// answer to "who used which credential, and when", which nothing else here could
/// answer — an app holding OAuth tokens with `repo` + `workflow` and encrypted AWS
/// credentials needs that question to be answerable.
///
/// Append-only by convention: nothing in the application updates or deletes a row.
/// `userId` is nullable and set null on delete, so removing an account does not
/// erase the trail of what that account did — the rows outlive the user, which is
/// the property that makes them worth keeping at all.
///
/// Deliberately not a foreign-keyed enum: `action` is a string so a new event type
/// is one call site rather than a migration, and an unrecognised value in an old
/// row still reads.
model AuditEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Null for events with no authenticated actor, e.g. a rejected request.
  userId String? @map("user_id") @db.Uuid

  /// Dotted and coarse, e.g. `auth.denied`, `aws.credentials.issued`,
  /// `deploy.run.started`, `harness.updated`.
  action String @db.Text

  /// What it happened to, when that is a single row: a project or connection id.
  subject String? @db.Text

  /// Whether the attempt succeeded. A denial is the more interesting row.
  outcome String @default("ok") @db.Text

  /// Request context. Only present when the app is behind a proxy it trusts.
  ip        String? @db.Text
  userAgent String? @map("user_agent") @db.Text

  /// Anything else worth keeping, e.g. `{"reason":"not-owner"}`. Never a secret:
  /// this table is read by people who are not necessarily the actor.
  detail Json @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
  @@schema("public")
}

/// A remote MCP server the agent may call on this user's behalf.
///
/// Remote only. A local (stdio) server would be a command executed on the
/// Terrablox host, which is remote code execution for anyone with an account,
/// so that transport is deliberately not modelled at all rather than modelled
/// and disabled.
model AgentMcpServer {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// What the user calls it, and the namespace its tools appear under.
  name      String @db.Text
  /// Must be https, enforced in the service.
  url       String @db.Text
  /// "http" or "sse".
  transport String @default("http") @db.Text

  /// Auth headers, AES-256-GCM encrypted. These are bearer tokens for someone
  /// else's system: a database dump must not be enough to use them.
  headersCiphertext String? @map("headers_ciphertext") @db.Text

  /// Off by default, so adding a server is not the same as trusting it.
  enabled Boolean @default(false)

  /// The tools this server said it has, as of `toolsSyncedAt`.
  ///
  /// A cache of somebody else's catalogue, not a source of truth: we ask the
  /// server over MCP when it is added and whenever the user refreshes. Stored so
  /// the settings screen can offer a switch per tool without making a network
  /// request to draw a page, and so a server that is temporarily down still shows
  /// what it had. The session is configured from `name` plus this list minus
  /// `disabledTools`, so a stale entry can only ever withhold a tool, never invent
  /// one — the server itself decides what actually exists.
  ///
  /// Shape: `[{ name, title, description, readOnly }]`. `readOnly` is the server's
  /// own annotation, which we pass on as its claim rather than as a fact.
  tools Json? @db.JsonB

  /// When the list above was last fetched. Null means never, which the UI shows
  /// as "not checked yet" rather than as a server without tools.
  toolsSyncedAt DateTime? @map("tools_synced_at") @db.Timestamptz(6)

  /// Tools of this server the agent may not call, by name.
  ///
  /// A deny list, like every other tool switch here, and for the same reason: an
  /// allow list cannot tell "never configured" apart from "deliberately empty", so
  /// a server added before this column existed would silently offer nothing.
  /// Enforced by absence — the names left over are sent as the session's allow
  /// list for this server, so a disabled tool is not registered at all.
  disabledTools String[] @default([]) @map("disabled_tools")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("agent_mcp_servers")
  @@schema("public")
}
