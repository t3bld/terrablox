{
  "name": "@terrablox/database",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "postinstall": "DATABASE_URL=${DATABASE_URL:-postgresql://generate-does-not-connect} prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@terrablox/tsconfig": "workspace:*",
    "@types/node": "^20.10.5",
    "prisma": "^5.22.0",
    "typescript": "^5.3.3"
  }
}
