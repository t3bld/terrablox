# =============================================================================
# Prisma CLI only
# =============================================================================
#
# This file exists because the Prisma CLI resolves env vars relative to the
# schema, so it cannot read apps/dashboard/.env. It deliberately holds nothing
# but the connection string - application config and secrets belong in
# apps/dashboard/.env and are never duplicated here.
#
# Keep these in sync with DATABASE_URL in apps/dashboard/.env.
# Start the database with `pnpm db:up` at the repo root.

DATABASE_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"
DIRECT_URL="postgresql://terrablox:terrablox@localhost:5433/terrablox"
