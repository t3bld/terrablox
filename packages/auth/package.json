{
  "name": "@terrablox/auth",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/use-auth.tsx",
      "default": "./src/hooks/use-auth.tsx"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./adapters/supabase": {
      "types": "./src/adapters/supabase.ts",
      "default": "./src/adapters/supabase.ts"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.39.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@terrablox/tsconfig": "workspace:*",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
