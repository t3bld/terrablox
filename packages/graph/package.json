{
  "name": "@terrablox/graph",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./dependency-graph": "./src/dependency-graph.tsx",
    "./styles.css": "./src/styles.css",
    "./tailwind.config": "./tailwind.config.js",
    "./mcp-app": "./src/mcp-app/index.ts",
    "./canvas-model": "./src/canvas-model.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "build:app": "node ./build-app.mjs && biome check --write src/mcp-app/app.generated.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@xyflow/react": "^12",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@terrablox/tsconfig": "workspace:*",
    "@types/react": "^18.2.45",
    "@types/react-dom": "18",
    "esbuild": "0.25.12",
    "postcss": "8.5.31",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
